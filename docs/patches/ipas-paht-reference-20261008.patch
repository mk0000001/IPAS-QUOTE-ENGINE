diff --git a/tests/test_paht_exact_reference.py b/tests/test_paht_exact_reference.py
new file mode 100644
--- /dev/null
+++ b/tests/test_paht_exact_reference.py
@@ -0,0 +1,169 @@
+"""Only the exact Bambu PAHT-CF profile earns its documented TDS comparator."""
+from copy import deepcopy
+
+import pytest
+
+from app.filament_profiles import enrich_analysis, parse
+from app.strength_reference import capacity_reference, reference_for_subset, summarize
+
+
+SOURCE = 'https://store.bblcdn.com/7166b20bc68f4c87b32c972b856eeb4b.pdf'
+
+
+def analysis(profile='Bambu PAHT-CF @BBL H2C', material='PA-CF'):
+    return {'detected_materials': [material], 'tool_ids': [0],
+            'material_usage': [{'tool_id': 0, 'material': material, 'sku_profile': profile,
+                                'grams': '10', 'used_for_object': True}],
+            'configuration': {'filament_settings_id': [profile], 'filament_type': [material]}}
+
+
+def test_official_paht_profile_accepts_its_coarse_hint_without_rewriting_metadata():
+    source = analysis('Bambu PAHT-CF @base')
+    before = deepcopy(source)
+    identity = enrich_analysis(source)['material_usage'][0]['profile_identity']
+    assert identity['match_status'] == 'matched'
+    assert identity['canonical_profile'] == 'Bambu PAHT-CF'
+    assert identity['material'] == 'PAHT-CF'
+    assert identity['material_hint'] == 'PA-CF'
+    assert identity['raw_profile'] == 'Bambu PAHT-CF @base'
+    assert 'OFFICIAL_EXACT_PRODUCT_COARSE_GCODE_HINT' in identity['reasons']
+    assert source == before
+
+
+def test_configuration_bound_paht_identity_retains_its_source_provenance():
+    source = analysis('Bambu PAHT-CF @BBL H2C')
+    source['material_usage'][0]['sku_profile'] = None
+    before = deepcopy(source)
+    identity = enrich_analysis(source)['material_usage'][0]['profile_identity']
+    assert identity['match_status'] == 'matched'
+    assert identity['raw_profile'] == ''
+    assert identity['source_profile'] == 'Bambu PAHT-CF @BBL H2C'
+    assert identity['profile_source'] == 'CONFIGURATION_TOOL_SLOT'
+    assert identity['source_tool_id'] == 0
+    assert identity['configuration_index'] == 0
+    assert identity['material_hint'] == 'PA-CF'
+    assert summarize(source)['raw_reference_mpa'] == {'XY': '92', 'Z': '47'}
+    assert source == before
+
+
+@pytest.mark.parametrize('material', ['PLA', 'PA6-CF', 'PA12-CF'])
+def test_paht_profile_rejects_other_explicit_polymer_hints(material):
+    identity = parse('Bambu PAHT-CF @BBL H2C', material)
+    assert identity['match_status'] == 'conflict'
+    assert 'MATERIAL_HINT_CONFLICT' in identity['reasons']
+    report = summarize(analysis(material=material))
+    assert report['reference_kind'] == 'PROFILE_IDENTITY_CONFLICT'
+    assert report.get('raw_reference_mpa') in (None, {})
+    assert capacity_reference(report) is None
+
+
+@pytest.mark.parametrize('profile', ['eSUN PAHT-CF', 'Bambu PA6-CF', 'Bambu PA12-CF'])
+def test_coarse_pa_cf_hint_is_not_a_general_nylon_grade_equivalence(profile):
+    identity = parse(profile, 'PA-CF')
+    assert identity['match_status'] == 'conflict'
+    assert 'MATERIAL_HINT_CONFLICT' in identity['reasons']
+    report = summarize(analysis(profile))
+    assert report.get('raw_reference_mpa') in (None, {})
+
+
+@pytest.mark.parametrize('profile', ['Generic PA-CF', 'PA-CF', 'Bambu PA-CF', 'Generic PAHT-CF'])
+def test_generic_or_unspecified_pa_cf_never_borrows_exact_paht_values(profile):
+    report = summarize(analysis(profile))
+    assert report.get('reference_product') != 'Bambu Lab PAHT-CF'
+    assert report.get('raw_reference_mpa') in (None, {})
+    assert capacity_reference(report) is None
+
+
+def test_pa6_profile_with_pa12_hint_remains_a_conflict():
+    identity = parse('Bambu PA6-CF', 'PA12-CF')
+    assert identity['match_status'] == 'conflict'
+    assert summarize(analysis('Bambu PA6-CF', 'PA12-CF'))['reference_kind'] == 'PROFILE_IDENTITY_CONFLICT'
+
+
+@pytest.mark.parametrize('material', ['PA-CF', 'PAHT-CF'])
+def test_exact_paht_source_keeps_raw_coupon_values_and_applies_margin_only_to_capacity(material):
+    source = analysis(material=material)
+    before = deepcopy(source)
+    report = summarize(source)
+    assert report['status'] == 'REFERENCE_ONLY'
+    assert report['reference_kind'] == 'SLICER_PROFILE_REFERENCE_NOT_VERIFIED_SPOOL'
+    assert report['reference_product'] == 'Bambu Lab PAHT-CF'
+    assert report['source_ref'] == SOURCE
+    assert report['source_version'] == 'Technical Data Sheet V3.0'
+    assert report['raw_reference_mpa'] == {'XY': '92', 'Z': '47'}
+    assert report['directional_reference_mpa'] == {'X': '92', 'Y': '92', 'Z': '47'}
+    assert report['directional_capacity_reference_mpa'] == {'X': '78.2', 'Y': '78.2', 'Z': '39.95'}
+    assert report['reference_margin_applied'] is False
+    assert report['capacity_margin_applied'] is True
+    assert report['stress_area_basis'] == 'UNKNOWN'
+    assert report['test_conditions']['infill_percent'] == 100
+    assert report['test_conditions']['nozzle_c'] == 290
+    assert report['test_conditions']['bed_c'] == 100
+    assert report['test_conditions']['speed_mm_s'] == 100
+    assert report['test_conditions']['conditioning'] == '80°C에서 12시간 열처리·건조'
+    assert report['test_conditions']['moisture_state'] == 'DRY'
+    assert report['test_conditions']['test_standard'] == 'ISO 527 / GB/T 1040'
+    assert report['source_reported_spread_mpa'] == {'XY': '7', 'Z': '5'}
+    assert report['source_reported_spread_kind'] == 'UNDEFINED'
+    assert report['actual_moisture_state'] == 'UNKNOWN'
+    assert report['actual_annealing_state'] == 'UNKNOWN'
+    assert source == before
+
+
+def test_exact_same_product_multiple_tools_receive_explicit_common_product_proof():
+    from app.strength_points import attach_capacity
+    from print_strength_engine.automatic_sections import StreamingSections
+    source = analysis()
+    second = deepcopy(source['material_usage'][0])
+    second.update(tool_id=3, sku_profile='Bambu Lab PAHT-CF @BBL A1')
+    source['material_usage'].append(second)
+    source['tool_ids'] = [0, 3]
+    source['configuration'] = {'filament_settings_id': [source['material_usage'][0]['sku_profile'],
+                                                       second['sku_profile']],
+                               'filament_type': ['PA-CF', 'PA-CF']}
+    candidate = {'kind': 'COMPONENT_REFERENCE_SECTION', 'region_id': 'paht-two-tools',
+                 'layer_number': 1, 'z_mm': .2, 'position_mm': [5., 5., .1],
+                 'section_normal_axis': 'Z', 'section_station_mm': .1,
+                 'axial_section_station_mm': .1, 'bending_section_station_mm': .1,
+                 'section_window_bounds_mm': [[-1., 11.], [-1., 11.], [0., .4]],
+                 'bounds_mm': [[-1., 11.], [-1., 11.], [0., .4]],
+                 'material_area_proxy_mm2': 4}
+    writer = StreamingSections([candidate])
+    writer.segment([1, 2, .2], [5, 2, .2], 1, .2, 0)
+    writer.segment([5, 2, .2], [9, 2, .2], 1, .2, 3)
+    candidate['deposited_section'] = writer.finish()[candidate['region_id']]
+    before = deepcopy(candidate)
+    row = attach_capacity([candidate], None, source)[0]
+    value = row.get('estimated_capacity') or {}
+    assert value.get('calculation_status') == 'AUTOMATIC_REFERENCE_LOAD_ESTIMATE'
+    assert value['axial_capacity_n'] > 0
+    assert value['bending_force_n'] > 0
+    proof = row['capacity_material_reference']['common_product_tool_reference']
+    assert proof['basis'] == 'IDENTICAL_EXACT_PRODUCT_COUPON_REFERENCE_PER_TOOL'
+    assert proof['tool_ids'] == [0, 3]
+    assert proof['verified'] is False
+    assert proof['source_ref'] == SOURCE
+    assert proof['raw_reference_mpa'] == {'XY': '92', 'Z': '47'}
+    assert proof['stress_area_basis'] == 'UNKNOWN'
+    assert candidate == before
+    for tool in (0, 3):
+        subset = reference_for_subset(source, [tool])
+        assert subset['reference_product'] == 'Bambu Lab PAHT-CF'
+        assert subset['raw_reference_mpa'] == proof['raw_reference_mpa']
+
+
+def test_paht_customer_notes_keep_conditioning_caveat_without_internal_test_details():
+    from app.strength_reference import reference_notes
+    notes='\n'.join(reference_notes(summarize(analysis()),include_internal=False))
+    assert '건조·열처리 시험편 기준' in notes
+    assert '현재 출력물의 수분·열처리 상태는 확인되지 않았습니다' in notes
+    for internal in ('290°C','100 mm/s','80°C','±7','V3.0',SOURCE):
+        assert internal not in notes
+
+
+def test_paht_admin_notes_include_exact_source_and_conditioning_without_statistical_claim():
+    from app.strength_reference import reference_notes
+    notes='\n'.join(reference_notes(summarize(analysis()),include_internal=True))
+    for expected in ('건조·열처리 시험편 기준','290°C','100°C','100 mm/s','인필 100%',
+                     '80°C','12시간','±7','±5','표준편차나 신뢰구간으로 해석하지 않습니다','V3.0',SOURCE):
+        assert expected in notes
