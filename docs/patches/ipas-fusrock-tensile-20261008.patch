diff --git a/tests/test_fusrock_abs_gf_wiki_reference.py b/tests/test_fusrock_abs_gf_wiki_reference.py
new file mode 100644
--- /dev/null
+++ b/tests/test_fusrock_abs_gf_wiki_reference.py
@@ -0,0 +1,121 @@
+"""Exact manufacturer dry tensile pair; no grade/family borrowing or margin drift."""
+from copy import deepcopy
+
+import pytest
+
+from app.strength_reference import reference_for_subset, reference_notes, summarize
+from print_strength_engine.fusrock import exact_directional_reference, match_profiles
+
+WIKI = 'https://wiki.fusrock.com/zh/ABS-GF10/ABS-GF10'
+WIKI_SHA = 'b74c4c73fb2e8f3d831c107b7fa51e5c9b0a68baee806a3d4b3bf64cba976307'
+
+
+def analysis(profile='FusRock_ABS-GF_Default', material='ABS-GF'):
+    return {'detected_materials':[material],
+        'material_usage':[{'material':material,'sku_profile':profile,'tool_id':0}],
+        'configuration':{'filament_settings_id':profile}}
+
+
+def test_exact_abs_gf_uses_both_dry_tensile_break_endpoints_from_wiki():
+    product = match_profiles(['FusRock ABS-GF @QIDI Q2'])
+    before = deepcopy(product)
+    ref = exact_directional_reference(product)
+    assert ref is not None
+    assert ref['raw_reference_mpa'] == {'XY':'43.44','Z':'19.02'}
+    assert ref['source_ref'] == WIKI
+    assert ref['source_sha256'] == WIKI_SHA
+    assert ref['source_checked_at'] == '2026-10-08'
+    assert ref['source_metric_labels'] == {
+        'XY':'Tensile breaking strength (X-Y)', 'Z':'Tensile breaking strength (Z)'}
+    assert ref['source_metric_labels_original'] == {'XY':'拉伸断裂强度（X-Y）','Z':'拉伸断裂强度（Z）'}
+    assert ref['metric_comparability'] == 'SAME_SOURCE_ENDPOINT_AND_DRY_STATE'
+    assert ref['test_state'] == 'DRY'
+    assert ref['test_conditions'] == {'nozzle_mm':0.4,'nozzle_c':250,'bed_c':100,
+        'speed_mm_s':50,'infill_percent':100,'infill_angle':'±45°',
+        'moisture_state':'DRY','annealing_state':'UNKNOWN','test_standard':'ISO 527'}
+    assert product == before
+    assert product['metrics']['tbs_xy_unannealed'] == '-'
+    assert product['metrics']['ts_z_unannealed'] == 19.02
+
+
+@pytest.mark.parametrize('field,value', [('id',106),('brand','OtherBrand'),
+    ('material_name','ABS-GF50'),('material_model','ABS-GF50')])
+def test_supplement_requires_the_exact_catalog_product_identity(field,value):
+    product = deepcopy(match_profiles(['FusRock ABS-GF']))
+    product[field] = value
+    assert exact_directional_reference(product) is None
+
+
+@pytest.mark.parametrize('profile',['FusRock ABS GF 50%','FusRock ABS GF 50','FusRock ABS GF 10%'])
+def test_abs_gf_match_rejects_unlabelled_integer_reinforcement_grade(profile):
+    assert match_profiles([profile]) is None
+
+
+def test_report_uses_wiki_source_and_raw_values_with_margin_only_on_capacity():
+    source = analysis()
+    before = deepcopy(source)
+    report = summarize(source)
+    assert report['status'] == 'REFERENCE_ONLY'
+    assert report['reference_product'] == 'FusRock ABS-GF'
+    assert report['source_ref'] == WIKI
+    assert report['source_sha256'] == WIKI_SHA
+    assert report['source_checked_at'] == '2026-10-08'
+    assert report['raw_reference_mpa'] == {'XY':'43.44','Z':'19.02'}
+    assert report['directional_reference_mpa'] == {'X':'43.44','Y':'43.44','Z':'19.02'}
+    assert report['directional_capacity_reference_mpa'] == {'X':'36.924','Y':'36.924','Z':'16.167'}
+    assert report['reference_margin_applied'] is False
+    assert report['capacity_margin_applied'] is True
+    assert report['metric_comparability'] == 'SAME_SOURCE_ENDPOINT_AND_DRY_STATE'
+    assert report['stress_area_basis'] == 'UNKNOWN'
+    assert report['actual_moisture_state'] == 'UNKNOWN'
+    assert report['actual_annealing_state'] == 'UNKNOWN'
+    assert report['source_reported_spread_mpa'] == {'XY':'0.86','Z':'0.9'}
+    assert report['source_reported_spread_kind'] == 'UNDEFINED'
+    assert report['test_conditions']['annealing_state'] == 'UNKNOWN'
+    assert report['test_conditions']['moisture_state'] == 'DRY'
+    assert '비열처리' not in ' '.join(report['limitations'])
+    assert source == before
+    subset = reference_for_subset(source,[0])
+    assert subset['source_ref'] == WIKI
+    assert subset['directional_capacity_reference_mpa'] == report['directional_capacity_reference_mpa']
+
+
+def test_customer_and_admin_notes_disclose_dry_state_without_old_endpoint_conflict():
+    report = summarize(analysis())
+    customer = '\n'.join(reference_notes(report,include_internal=False))
+    admin = '\n'.join(reference_notes(report,include_internal=True))
+    assert '43.44' in customer and '19.02' in customer
+    assert '건조' in customer and '수분·열처리 상태' in customer
+    assert '동일한 파단 지표로 검증되지 않았습니다' not in customer
+    assert WIKI in admin
+    assert all(token in admin for token in ['250°C','100°C','50 mm/s','100%','±45°','ISO 527'])
+    assert '표준편차나 신뢰구간' in admin
+    assert '0.86' in admin and '0.9' in admin
+    assert '250°C' not in customer
+
+
+@pytest.mark.parametrize('profile', ['FusRock NexABS-GF25','FusRock ABS-CF',
+    'FusRock ABS-GF10','FusRock ABS-GF50','FusRock ABS GF 50%',
+    'Generic ABS-GF','OtherBrand ABS-GF'])
+def test_other_grades_and_brands_never_receive_the_wiki_pair(profile):
+    product = match_profiles([profile])
+    assert exact_directional_reference(product) is None
+    report = summarize(analysis(profile))
+    assert report.get('source_ref') != WIKI
+    assert report.get('raw_reference_mpa') != {'XY':'43.44','Z':'19.02'}
+
+
+@pytest.mark.parametrize('material', ['PLA','ASA','ABS-CF','PA-CF'])
+def test_conflicting_declared_polymer_cannot_use_the_abs_gf_pair(material):
+    report = summarize(analysis(material=material))
+    assert report.get('exact_reference_kind',report.get('reference_kind')) == 'PROFILE_IDENTITY_CONFLICT'
+    assert report.get('raw_reference_mpa') is None
+    assert report.get('source_ref') != WIKI
+
+
+def test_legacy_abs_endpoint_conflict_and_raw_values_stay_unchanged():
+    report = summarize(analysis('FusRock ABS','ABS'))
+    assert report['raw_reference_mpa'] == {'XY':'33.36','Z':'55'}
+    assert report['metric_comparability'] == 'SOURCE_LABEL_CONFLICT_ENDPOINT_COMPARABILITY_UNVERIFIED'
+    assert report['source_ref'] == 'https://www.fusrock.com/material/performance/id/106/lang/en'
+    assert '동일한 파단 지표로 검증되지 않았습니다' in '\n'.join(reference_notes(report))
