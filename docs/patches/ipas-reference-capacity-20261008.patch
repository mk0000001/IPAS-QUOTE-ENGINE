+        'failure_samples': [row for row in records if row['status'] == 'FAIL'][:12]}
+    write_json(out / 'summary.json', summary)
+    print(json.dumps({'status': status, 'counts': dict(counts), 'source_code_unchanged': unchanged,
+                      'elapsed_seconds': summary['elapsed_seconds']}, ensure_ascii=False), flush=True)
+    return 0 if status == 'PASS' else 1
