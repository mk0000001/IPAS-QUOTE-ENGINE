+"""Replay complete cached roads with current reference-capacity models.
+
+This never opens original G-code. Historical source hashes are linked, not
+freshly verified. Cache bytes are freshly hashed and checked while replaying.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from copy import deepcopy
+from datetime import datetime, timezone
+from hashlib import sha256
+import json
+import math
+import os
+from pathlib import Path
+import struct
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_OUT = ROOT / 'reports/ipas-reference-capacity-20261008/corpus'
+RECORD = struct.Struct('<8dI')
+SCHEMA = 'REFERENCE_CAPACITY_CACHE_REPLAY_V1'
+MODE = 'CACHE_ONLY_REPLAY_NO_ORIGINAL_RESCAN'
+
+
+def prepare_runtime():
+    for key in ('OPENBLAS_NUM_THREADS', 'OMP_NUM_THREADS', 'MKL_NUM_THREADS'):
+        os.environ[key] = '1'
+    for path in (ROOT, ROOT.parent / '.tools/strength-testdeps',
+                 ROOT / '.ops/report-runtime312', ROOT / '.ops/geometry_runtime',
+                 ROOT / 'external/print-strength-engine', ROOT / 'external/print-gcode-engine',
+                 ROOT / 'external/print-quote-engine'):
+        sys.path.insert(0, str(path))
+
+
+def digest(path):
+    value = sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            value.update(block)
+    return value.hexdigest()
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode('utf-8')
+
+
+def write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_bytes(canonical(value))
+    temporary.replace(path)
+
+
+def read_json(path):
+    return json.loads(Path(path).read_text(encoding='utf-8'))
+
+
+def source_map():
+    paths = [Path(__file__)]
+    for directory in (ROOT / 'app', *(ROOT / 'external').glob('print-*/print_*_engine')):
+        paths.extend(path for path in directory.rglob('*') if path.is_file() and path.suffix in ('.py', '.json'))
+    return {path.relative_to(ROOT).as_posix(): digest(path) for path in sorted(set(paths))}
+
+
+def finite(value, positive=False):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and (value > 0 if positive else True)
+
+
+def numeric(candidate):
+    capacity = candidate.get('estimated_capacity') or {}
+    return capacity.get('calculation_status') == 'AUTOMATIC_REFERENCE_LOAD_ESTIMATE' and any(
+        finite(capacity.get(key), True) for key in ('axial_capacity_n', 'bending_force_n'))
+
+
+def latest_events(directory):
+    events = {}
+    for path in sorted(Path(directory).glob('results-[012].jsonl')):
+        with path.open(encoding='utf-8') as stream:
+            for line in stream:
+                event = json.loads(line)
+                if event.get('stage') != 'PLATE_GEOMETRY':
+                    continue
+                key = (event['artifact_id'], event.get('archive_member') or '')
+                if key not in events or event.get('completed_at', '') >= events[key].get('completed_at', ''):
+                    events[key] = event
+    return events
+
+
+def inventory(manifest, events):
+    expected = {}
+    for payload in manifest['gcode_payloads']:
+        members = payload.get('members') or []
+        # ZIP payload lineage includes the outer member before any inner 3MF
+        # plate. The selected scanner member is relative to that artifact.
+        if payload.get('source_format', '').startswith('zip/'):
+            members = members[1:]
+        for member in members or [{'name': ''}]:
+            key = (payload['source_id'], member.get('name') or '')
+            if key in expected:
+                raise ValueError('DUPLICATE_INVENTORY_PAYLOAD')
+            expected[key] = {'source_sha256': payload['source_sha256'],
+                             'gcode_sha256': payload['gcode_sha256'], 'gcode_bytes': payload['gcode_bytes']}
+    if expected.keys() != events.keys():
+        raise ValueError('INVENTORY_EVENT_PAYLOAD_SET_MISMATCH')
+    tasks = []
+    for key, event in events.items():
+        task = {'event': event, 'expected': expected[key]}
+        try:
+            task['record_count'] = read_json(Path(event['assessment_path']).parent / 'deposition-v1.json').get('count', 0)
+        except (OSError, ValueError):
+            task['record_count'] = 0
+        tasks.append(task)
+    return sorted(tasks, key=lambda task: (task['record_count'], task['event']['artifact_id'], task['event'].get('archive_member', '')))
+
+
+def select_analysis(scan, member):
+    analysis = scan['analysis']
+    if analysis.get('requires_plate_selection'):
+        plates = analysis.get('plates') or []
+        selected = [plate for plate in plates if (plate.get('archive_member') or '') == member]
+        if len(selected) != 1:
+            raise ValueError('SCAN_PLATE_SELECTION_IDENTITY_MISMATCH')
+        analysis = selected[0].get('analysis', selected[0])
+    return analysis
+
+
+def linked_inputs(task):
+    event = task['event']; expected = task['expected']
+    assessment_path = Path(event['assessment_path']).resolve()
+    scan_path = Path(event['scan_path']).resolve()
+    fresh = (ROOT / 'reports/full-corpus-20261003/fresh').resolve()
+    if not assessment_path.is_relative_to(fresh / 'plates') or not scan_path.is_relative_to(fresh / 'artifacts'):
+        raise ValueError('CACHE_PATH_OUTSIDE_FRESH_INVENTORY')
+    assessment = read_json(assessment_path); scan = read_json(scan_path)
+    member = event.get('archive_member') or ''
+    for value in (event, assessment):
+        if (value.get('source_sha256') != expected['source_sha256'] or
+                value.get('selected_gcode_sha256') != expected['gcode_sha256'] or
+                (value.get('archive_member') or '') != member):
+            raise ValueError('ASSESSMENT_INVENTORY_HASH_LINK_MISMATCH')
+        if value.get('plate_key') != assessment_path.parent.name:
+            raise ValueError('ASSESSMENT_PLATE_DIRECTORY_IDENTITY_MISMATCH')
+    if scan.get('source_sha256') != expected['source_sha256']:
+        raise ValueError('SCAN_SOURCE_HASH_LINK_MISMATCH')
+    if (scan.get('source_proof') or {}).get('effective_sha256') != expected['source_sha256']:
+        raise ValueError('HISTORICAL_SOURCE_PROOF_HASH_MISMATCH')
+    if event.get('source_immutable') is not True or event.get('final_effective_sha256') != expected['source_sha256']:
+        raise ValueError('HISTORICAL_FINAL_SOURCE_IDENTITY_UNVERIFIED')
+    if any(value.get('engine_fingerprint') != event.get('engine_fingerprint') for value in (assessment, scan)):
+        raise ValueError('HISTORICAL_ENGINE_LINK_MISMATCH')
+    analysis = select_analysis(scan, member)
+    proof = analysis.get('_corpus_stream_proof') or {}
+    if (analysis.get('_corpus_payload_sha256') != expected['gcode_sha256'] or
+            proof.get('consumed_bytes') != expected['gcode_bytes'] or proof.get('total_bytes') != expected['gcode_bytes']):
+        raise ValueError('HISTORICAL_SELECTED_STREAM_EOF_HASH_MISMATCH')
+    links = {'basis': 'HISTORICAL_ARTIFACT_LINKED_HASH_NO_ORIGINAL_SOURCE_REHASH',
+             **expected, 'assessment_sha256': digest(assessment_path), 'scan_sha256': digest(scan_path),
+             'assessment_artifact_alias': assessment.get('artifact_id') != event['artifact_id']}
+    return assessment_path.parent, assessment, analysis, links
+
+
+def metadata_cache(directory):
+    meta_path = directory / 'deposition-v1.json'
+    meta = read_json(meta_path); layers = meta.get('layers')
+    if meta.get('version') != 1 or not isinstance(layers, dict):
+        raise ValueError('INVALID_DEPOSITION_CACHE_METADATA')
+    files = []; total = 0
+    for key, count in layers.items():
+        if not key.isdecimal() or str(int(key)) != key or not isinstance(count, int) or isinstance(count, bool) or count <= 0:
+            raise ValueError('INVALID_DEPOSITION_LAYER_COUNT')
+        path = directory / (key + '.dep'); stat = path.stat()
+        if stat.st_size != count * RECORD.size:
+            raise ValueError('DEPOSITION_CACHE_SIZE_COUNT_MISMATCH')
+        with path.open('rb') as stream:
+            first = RECORD.unpack(stream.read(RECORD.size))
+        files.append((int(key), count, path, stat.st_size, stat.st_mtime_ns, first))
+        total += count
+    if total != meta.get('count'):
+        raise ValueError('DEPOSITION_TOTAL_COUNT_MISMATCH')
+    actual_files = {path.name for path in directory.glob('*.dep')}
+    if actual_files != {row[2].name for row in files}:
+        raise ValueError('DEPOSITION_UNLISTED_LAYER_FILE')
+    reasons = []
+    if meta.get('complete') is not True: reasons.append('CACHE_DECLARED_INCOMPLETE')
+    if meta.get('sampled') is not False: reasons.append('CACHE_SAMPLED_OR_UNKNOWN')
+    if meta.get('missing'): reasons.append('CACHE_MISSING_DECLARED_DIMENSIONS_OR_RECORDS')
+    if meta.get('truncated'): reasons.append('CACHE_TRUNCATED')
+    if meta.get('excluded_arcs'): reasons.append('CACHE_EXCLUDED_ARCS')
+    if meta.get('provenance') != 'GCODE_WIDTH_HEIGHT_ASSUMPTION': reasons.append('CACHE_PROVENANCE_UNSUPPORTED')
+    return meta, sorted(files), sorted(set(reasons)), digest(meta_path)
+
+
+def candidate_references(directory, local, analysis, files):
+    from print_strength_engine.component_sections import reference_section_candidates
+    profile = analysis.get('layer_volume_profile') or {}
+    coverage = local.get('contour_coverage') or local.get('coverage') or {}
+    bounds = coverage.get('bounds')
+    manifest_path = directory / 'manifest.json'
+    basis = 'CACHED_MANIFEST_MODEL_LAYERS'
+    if manifest_path.is_file():
+        manifest = read_json(manifest_path)
+        bounds = bounds or manifest.get('bounds')
+        models = [row for row in manifest.get('layers', []) if row.get('model', 0) > 0]
+        if len(models) == 1 and files:
+            height = files[0][5][7]
+            if finite(height, True) and .001 <= height <= 5:
+                models[0].setdefault('layer_height_mm', height)
+    else:
+        # Counts are actual recorded model roads, not volume proxies.
+        by_id = {row.get('layer_number'): row for row in profile.get('layers', [])}
+        models = []
+        for layer, count, _, _, _, first in files:
+            z = by_id.get(layer, {}).get('z_mm')
+            if not finite(z): z = first[2]
+            row = {'id': layer, 'z_mm': z, 'model': count}
+            if len(files) == 1 and finite(first[7], True) and .001 <= first[7] <= 5:
+                row['layer_height_mm'] = first[7]
+            models.append(row)
+        manifest = {'layers': models}
+        basis = 'CACHED_DEP_MODEL_COUNTS_AND_SCAN_LAYER_Z'
+    if isinstance(bounds, list) and len(bounds) == 3:
+        # Match host query bounds. This only encloses supported 5-mm roads;
+        # the union of observed roads supplies all section area and moments.
+        bounds = deepcopy(bounds)
+        for pair in bounds[:2]:
+            pair[0] -= 2.5; pair[1] += 2.5
+    refs = reference_section_candidates(manifest, profile, bounds)
+    for row in refs:
+        row['cache_reference_layer_basis'] = basis
+        if len(files) == 1 and row.get('reference_height_basis') == 'SAME_LAYER_HEIGHT_METADATA':
+            row['cache_reference_height_basis'] = 'OBSERVED_CACHED_ROAD_DECLARED_HEIGHT'
+    return refs, bounds, basis
+
+
+def replay_records(files, collectors):
+    import numpy as np
+    dtype = np.dtype([('values', '<f8', (8,)), ('tool', '<u4')], align=False)
+    assert dtype.itemsize == RECORD.size
+    seen = replayed = 0; hashes = {}; gaps = set()
+    cuts = [cut for collector in collectors for cut in collector.cuts.values()]
+    for layer, expected, path, size, modified, first in files:
+        value_hash = sha256(); file_count = 0
+        with path.open('rb') as stream:
+            while block := stream.read(RECORD.size * 8192):
+                value_hash.update(block)
+                if len(block) % RECORD.size: raise ValueError('CACHE_PARTIAL_RECORD')
+                records = np.frombuffer(block, dtype=dtype); values = records['values']
+                file_count += len(records); seen += len(records)
+                valid = (np.isfinite(values).all(axis=1) & (np.abs(values[:, :6]) <= 1e6).all(axis=1) &
+                         (values[:, 6] >= .001) & (values[:, 6] <= 10) &
+                         (values[:, 7] >= .001) & (values[:, 7] <= 10) & (values[:, 2] == values[:, 5]))
+                if not valid.all(): gaps.add('INVALID_OR_UNSUPPORTED_CACHED_DEPOSITION_RECORD')
+                low = np.minimum(values[:, :3], values[:, 3:6]).copy()
+                high = np.maximum(values[:, :3], values[:, 3:6]).copy()
+                low[:, :2] -= values[:, 6, None] / 2; high[:, :2] += values[:, 6, None] / 2
+                low[:, 2] = values[:, 2] - values[:, 7]; high[:, 2] = values[:, 2]
+                selected = np.zeros(len(records), dtype=bool)
+                for cut in cuts:
+                    axis = cut['axis']; bounds = cut['bounds']; u = cut['u']; v = cut['v']; station = cut['station']
+                    selected |= ((low[:, axis] <= station) & (station < high[:, axis]) &
+                                 (high[:, u] > bounds[u][0]) & (low[:, u] < bounds[u][1]) &
+                                 (high[:, v] > bounds[v][0]) & (low[:, v] < bounds[v][1]))
+                for record in records[selected & valid]:
+                    row = record['values']; tool = int(record['tool'])
+                    for collector in collectors:
+                        collector.segment(tuple(row[:3]), tuple(row[3:6]), float(row[6]), float(row[7]), tool)
+                    replayed += 1
+        current = path.stat()
+        if file_count != expected or current.st_size != size or current.st_mtime_ns != modified:
+            raise ValueError('CACHE_CHANGED_OR_RECORD_COUNT_MISMATCH_DURING_REPLAY')
+        hashes[path.name] = value_hash.hexdigest()
+    return seen, replayed, hashes, sorted(gaps)
+
+
+def process_task(task):
+    started = time.monotonic(); event = task['event']
+    result = {'artifact_id': event['artifact_id'], 'archive_member': event.get('archive_member') or '',
+              'source_path': event.get('source_path'), 'classification': event.get('classification'),
+              'mode': MODE, 'status': 'PASS', 'numeric': False, 'null_reasons': [], 'invariant_violations': [],
+              'old_numeric': any(any(finite(row.get(key), True) for key in ('axial_capacity_n', 'bending_force_n'))
+                                 for row in event.get('candidate_summary') or [])}
+    try:
+        prepare_runtime()
+        from app.filament_profiles import enrich_analysis
+        from app.strength_reference import summarize, capacity_reference
+        from app.strength_points import attach_capacity
+        from print_strength_engine.automatic_sections import StreamingSections, VERSION as SECTION_VERSION
+        from print_strength_engine.capacity import VERSION as CAPACITY_VERSION
+        from print_strength_engine.weakness import VERSION as WEAKNESS_VERSION
+        directory, assessment, analysis, links = linked_inputs(task)
+        result['input_linkage'] = links
+        result['model_versions'] = {'section': SECTION_VERSION, 'capacity': CAPACITY_VERSION, 'weakness': WEAKNESS_VERSION}
+        if event.get('classification') == 'NON_PRINT_CONTROL':
+            result['null_reasons'] = ['NON_PRINT_CONTROL_NO_MODEL_DEPOSITION']
+            return result
+        meta, files, cache_reasons, meta_hash = metadata_cache(directory)
+        result['cache_metadata_sha256'] = meta_hash
+        result['cache_declared_complete'] = meta.get('complete') is True
+        result['cache_declared_record_count'] = meta.get('count')
+        result['cache_rejected_records'] = meta.get('rejected') or {}
+        local = assessment.get('local') or {}
+        thins = deepcopy(local.get('candidates') or [])
+        if len(thins) > 6: raise ValueError('LOCAL_THIN_CANDIDATE_LIMIT_EXCEEDED')
+        for row in thins:
+            row.setdefault('kind', 'LOCAL_THIN_SECTION')
+        refs, bounds, basis = candidate_references(directory, local, analysis, files)
+        result['reference_selection_basis'] = basis
+        collectors = [StreamingSections(rows) for rows in (thins, refs) if rows]
+        # Known-incomplete sidecars can never certify a cut. Still validate and
+        # hash every cached record, but avoid building geometry already withheld.
+        total, replayed, cache_hashes, record_gaps = replay_records(files, collectors if not cache_reasons else [])
+        cache_reasons.extend(record_gaps)
+        result.update(cache_records_total=total, cache_records_replayed=replayed,
+                      cache_file_sha256=cache_hashes, cache_complete=not cache_reasons)
+        sections = {}
+        for collector in collectors:
+            sections.update(collector.finish(complete=not cache_reasons))
+        analysis = enrich_analysis(analysis); reference = summarize(analysis)
+        reference_id = sha256(canonical({key: reference.get(key) for key in
+            ('reference_product', 'source_ref', 'raw_reference_mpa', 'stress_area_basis')})).hexdigest()
+        candidates = thins + refs
+        for row in candidates:
+            row['deposited_section'] = sections[row['region_id']]
+            row.update(source_sha256=task['expected']['source_sha256'], material_reference_id=reference_id)
+        # The binary cache has no commanded E-volume or thermal commands. Old
+        # contact/process records remain historical evidence, never fabricated.
+        candidates = attach_capacity(candidates, capacity_reference(reference), analysis, bounds,
+            reference_area_basis=reference.get('stress_area_basis', 'UNKNOWN'),
+            bending_supported=reference.get('rigid_bending_reference_supported', True))
+        result.update(thin_candidates=len(thins), reference_candidates=len(refs),
+                      reference_kind=reference.get('reference_kind'), reference_product=reference.get('reference_product'),
+                      material_reference_status=reference.get('status'),
+                      geometry_scope='DECLARED_ROADS_REPLAY; COMMANDED_VOLUME_NOT_RECONSTRUCTED; CONTACT_NOT_RECOMPUTED')
+        result['numeric'] = bool(candidates and numeric(candidates[0]))
+        summaries = []
+        for row in candidates:
+            section = row.get('deposited_section') or {}; capacity = row.get('estimated_capacity') or {}
+            material = row.get('capacity_material_reference') or {}
+            summaries.append({key: row.get(key) for key in ('region_id', 'kind', 'rank', 'rank_basis', 'selection_reason')})
+            summaries[-1].update(section_status=section.get('status'), component_count=section.get('component_count'),
+                tools=section.get('tools'), load_status=capacity.get('calculation_status'),
+                axial_capacity_n=capacity.get('axial_capacity_n'), bending_force_n=capacity.get('bending_force_n'),
+                bending_supported=capacity.get('bending_supported', True), assessment_gaps=capacity.get('assessment_gaps') or [],
+                tool_reference_product=material.get('reference_product'), tool_reference_kind=material.get('reference_kind'))
+            if len(section.get('tools') or []) > 1:
+                tools = set(section['tools'])
+                identities = [usage.get('profile_identity') or {} for usage in analysis.get('material_usage') or []
+                              if usage.get('tool_id') in tools]
+                names = {identity.get('canonical_profile') for identity in identities if identity.get('canonical_profile')}
+                summaries[-1]['multi_tool_same_identified_profile'] = bool(identities) and len(names) == 1 and all(
+                    identity.get('match_status') == 'matched' for identity in identities)
+                summaries[-1]['multi_tool_profile_names'] = sorted(names)
+            if numeric(row) and section.get('status') != 'COMPLETE': result['invariant_violations'].append('NUMERIC_WITHOUT_COMPLETE_SECTION')
+            if capacity.get('is_failure_prediction') is True or row.get('is_failure_prediction') is True:
+                result['invariant_violations'].append('REFERENCE_MISLABELED_FAILURE_PREDICTION')
+            if capacity.get('bending_supported') is False and capacity.get('bending_force_n') is not None:
+                result['invariant_violations'].append('UNSUPPORTED_MATERIAL_BENDING_NUMBER')
+        result['candidates'] = summaries
+        if not result['numeric']:
+            reasons = list(cache_reasons)
+            if not candidates: reasons.append('NO_BOUNDED_REFERENCE_OR_LOCAL_CANDIDATES')
+            if capacity_reference(reference) is None: reasons.append('MATERIAL_DIRECTIONAL_REFERENCE_UNAVAILABLE:' + str(reference.get('status')))
+            reasons.extend(gap for row in summaries for gap in row['assessment_gaps'])
+            reasons.extend('SECTION_' + str(row['section_status']) for row in summaries if row['section_status'] != 'COMPLETE')
+            if any(len(row.get('tools') or []) > 1 for row in summaries): reasons.append('MULTI_TOOL_CONNECTED_SECTION_NOT_HOMOGENIZED')
+            result['null_reasons'] = sorted(set(reasons))
+            if not reasons: result['invariant_violations'].append('UNEXPLAINED_NULL')
+        if result['invariant_violations']: result['status'] = 'FAIL'
+    except Exception as error:
+        result.update(status='FAIL', null_reasons=[type(error).__name__ + ':' + str(error)])
+        result['invariant_violations'].append('REPLAY_INPUT_OR_RUNTIME_FAILURE')
+    finally:
+        result['elapsed_seconds'] = round(time.monotonic() - started, 3)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, default=DEFAULT_OUT)
+    parser.add_argument('--workers', type=int, default=3)
+    parser.add_argument('--limit', type=int)
+    parser.add_argument('--inventory-only', action='store_true')
+    args = parser.parse_args()
+    sys.stdout.reconfigure(encoding='utf-8')
+    if not 1 <= args.workers <= 6: parser.error('workers must be 1..6')
+    out = args.out.resolve()
+    if not out.is_relative_to(DEFAULT_OUT): parser.error('output must stay in the new corpus directory')
+    out.mkdir(parents=True, exist_ok=True)
+    prepare_runtime(); start = time.monotonic(); before = source_map()
+    manifest_path = ROOT / 'reports/full-corpus-20261003/manifest-expanded.json'
+    fresh = manifest_path.parent / 'fresh'
+    input_hashes = {path.relative_to(ROOT).as_posix(): digest(path) for path in
+                    (manifest_path, *(fresh / f'results-{index}.jsonl' for index in range(3)))}
+    events = latest_events(fresh); tasks = inventory(read_json(manifest_path), events)
+    counts = Counter(payloads=len(tasks), printing=sum(task['event']['classification'] == 'PRINTABLE_GCODE' for task in tasks),
+                     controls=sum(task['event']['classification'] == 'NON_PRINT_CONTROL' for task in tasks))
+    identity = sha256(canonical({'input_sha256': input_hashes, 'source_code_sha256': before})).hexdigest()
+    if args.inventory_only:
+        write_json(out / 'inventory.json', {'schema': SCHEMA, 'mode': MODE, 'counts': dict(counts),
+            'input_sha256': input_hashes, 'identity_sha256': identity, 'source_code_sha256': before})
+        print(json.dumps({'inventory': dict(counts)}, ensure_ascii=False)); return
+    if args.limit: tasks = tasks[:args.limit]
+    records = []; reasons = Counter()
+    with (out / 'results.jsonl').open('w', encoding='utf-8') as stream:
+        with ProcessPoolExecutor(max_workers=args.workers) as pool:
+            futures = {pool.submit(process_task, task): task for task in tasks}
+            for future in as_completed(futures):
+                result = future.result(); records.append(result)
+                stream.write(canonical(result).decode('utf-8') + '\n'); stream.flush()
+                if result['classification'] == 'PRINTABLE_GCODE':
+                    reasons.update(result.get('null_reasons') or [])
+                if len(records) % 25 == 0 or result['status'] == 'FAIL':
+                    print(json.dumps({'processed': len(records), 'numeric': sum(row['numeric'] for row in records),
+                        'failures': sum(row['status'] == 'FAIL' for row in records), 'seconds': round(time.monotonic()-start, 1),
+                        'last': result['artifact_id'], 'last_reasons': result['null_reasons'] if result['status']=='FAIL' else []}, ensure_ascii=False), flush=True)
+    printing = [row for row in records if row['classification'] == 'PRINTABLE_GCODE']
+    counts.update(processed=len(records), old_numeric=sum(row['old_numeric'] for row in printing),
+        new_numeric=sum(row['numeric'] for row in printing), null=sum(not row['numeric'] for row in printing),
+        cache_complete=sum(row.get('cache_complete') is True for row in printing),
+        cache_incomplete=sum(row.get('cache_complete') is not True for row in printing),
+        old_numeric_complete_cache=sum(row['old_numeric'] and row.get('cache_complete') is True for row in printing),
+        old_numeric_incomplete_cache=sum(row['old_numeric'] and row.get('cache_complete') is not True for row in printing),
+        invariant_failures=sum(len(row['invariant_violations']) for row in records),
+        unexplained_null=sum(not row['numeric'] and not row['null_reasons'] for row in printing),
+        multi_tool_null=sum(not row['numeric'] and 'MULTI_TOOL_CONNECTED_SECTION_NOT_HOMOGENIZED' in row['null_reasons'] for row in printing),
+        same_profile_multi_tool_null=sum(not row['numeric'] and any(candidate.get('multi_tool_same_identified_profile')
+                                         for candidate in row.get('candidates') or []) for row in printing))
+    after = source_map(); unchanged = before == after
+    complete = len(records) == counts['payloads'] and not args.limit
+    status = 'PASS' if complete and unchanged and not counts['invariant_failures'] and not counts['unexplained_null'] else 'FAIL'
+    summary = {'schema': SCHEMA, 'mode': MODE, 'status': status,
+        'generated_at_utc': datetime.now(timezone.utc).isoformat(), 'image_id': None,
+        'identity_sha256': identity, 'input_sha256': input_hashes,
+        'source_code_sha256': before, 'source_code_sha256_end': after, 'source_code_unchanged': unchanged,
