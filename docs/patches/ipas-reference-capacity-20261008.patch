+class _CollectorGroups:
+    """Keep each engine's candidate cap while feeding a single original scan."""
+    def __init__(self,factory,candidates,**kwargs):
+        self.groups=[factory(candidates[index:index+6],**kwargs) for index in range(0,len(candidates),6)]
+    def segment(self,*args,**kwargs):
+        for group in self.groups:group.segment(*args,**kwargs)
+    def motion(self,*args,**kwargs):
+        for group in self.groups:group.motion(*args,**kwargs)
+    def finish(self,**kwargs):
+        result={}
+        for group in self.groups:
+            values=group.finish(**kwargs)
+            if result.keys() & values.keys():raise ValueError('DUPLICATE_CAPACITY_REGION_ID')
+            result.update(values)
+        return result
 
 
