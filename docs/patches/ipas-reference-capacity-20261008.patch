@@ -0,0 +1,111 @@
+"""Deployment gates accept explained corpus gaps and reject stale code evidence."""
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import pytest
+
+
+def release_module():
+    path=Path(__file__).resolve().parents[1]/'.ops/ipas_reference_capacity_release_20261008.py'
+    # The operational helper is a read-only staged QA control, not a runtime file.
+    if not path.is_file():path=Path('/report-release-qa/ipas_reference_capacity_release_20261008.py')
+    if not path.is_file():pytest.skip('Release helper unavailable outside the staged release QA environment')
+    spec=importlib.util.spec_from_file_location('reference_capacity_release_guards',path)
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+
+def evidence(module):
+    source={key:'a'*64 for key in (
+        'external/print-strength-engine/print_strength_engine/automatic_sections.py',
+        'external/print-strength-engine/print_strength_engine/capacity.py',
+        'external/print-strength-engine/print_strength_engine/component_sections.py',
+        'app/strength_reference.py','app/strength_points.py','app/strength_family_references.json',
+        'tools/reference_capacity_corpus_20261008.py')}
+    digest=hashlib.sha256(json.dumps(source,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
+    receipt={'schema':'REFERENCE_CAPACITY_CACHE_REPLAY_V1','status':'PASS',
+        'mode':'CACHE_ONLY_REPLAY_NO_ORIGINAL_RESCAN','identity_sha256':'b'*64,
+        'source_code_sha256':source,'source_code_sha256_end':deepcopy(source),
+        'source_code_digest':digest,'source_code_unchanged':True,
+        'counts':{'payloads':1693,'printing':1691,'controls':2,
+            'new_numeric':1690,'null':1,'unexplained_null':0,'invariant_failures':0}}
+    frozen={'runtime_sha256':{key:value for key,value in source.items() if not key.startswith('tools/')},
+        'build_input_sha256':dict(source)}
+    return receipt,frozen
+
+
+def test_cache_corpus_gate_accepts_explained_null_without_claiming_image_execution():
+    module=release_module();receipt,frozen=evidence(module)
+    result=module.validate_corpus_receipt(receipt,frozen)
+    assert result['counts']['null']==1
+    assert result['source_matches_frozen_image_inputs'] is True
+    assert result['image_execution'] is False
+
+
+@pytest.mark.parametrize('mutation',[
+    lambda r:r['counts'].update(unexplained_null=1),
+    lambda r:r['counts'].update(printing=1690),
+    lambda r:r['counts'].update(invariant_failures=1),
+    lambda r:r.update(status='FAIL'),
+    lambda r:r.update(source_code_unchanged=False),
+    lambda r:r['source_code_sha256_end'].update({'app/strength_reference.py':'c'*64}),
+    lambda r:r.update(source_code_digest='d'*64),
+])
+def test_cache_corpus_gate_rejects_incomplete_or_stale_replay(mutation):
+    module=release_module();receipt,frozen=evidence(module);mutation(receipt)
+    with pytest.raises(RuntimeError):module.validate_corpus_receipt(receipt,frozen)
+
+
+def test_cache_corpus_gate_rejects_source_different_from_frozen_image_inputs():
+    module=release_module();receipt,frozen=evidence(module)
+    key='app/strength_reference.py'
+    frozen['runtime_sha256'][key]=frozen['build_input_sha256'][key]='e'*64
+    with pytest.raises(RuntimeError):module.validate_corpus_receipt(receipt,frozen)
+
+
+def model_evidence(module):
+    parent,old=evidence(module);parent['source_code_sha256']['external/print-strength-engine/print_strength_engine/weakness.py']='a'*64
+    parent['source_code_sha256_end']=deepcopy(parent['source_code_sha256'])
+    parent['source_code_digest']=module.sha256(module.canonical(parent['source_code_sha256']))
+    old['runtime_sha256']=deepcopy(parent['source_code_sha256']);old['build_input_sha256']=deepcopy(parent['source_code_sha256'])
+    old['identity_sha256']='f'*64
+    current=deepcopy(parent)
+    delta=['app/strength_points.py','external/print-strength-engine/print_strength_engine/capacity.py','external/print-strength-engine/print_strength_engine/weakness.py']
+    for key in delta:current['source_code_sha256'][key]='c'*64
+    current['source_code_sha256_end']=deepcopy(current['source_code_sha256'])
+    current['source_code_digest']=module.sha256(module.canonical(current['source_code_sha256']))
+    current.update(schema='REFERENCE_CAPACITY_MODEL_REPLAY_V2',mode='CURRENT_CAPACITY_MODEL_REPLAY_OVER_FROZEN_CACHE_GEOMETRY',
+        geometry_source_code_sha256=deepcopy(parent['source_code_sha256']),geometry_source_code_digest=parent['source_code_digest'],
+        geometry_parent_receipt_sha256=module.sha256(module.canonical(parent)),geometry_source_freeze_identity_sha256=old['identity_sha256'],
+        geometry_algorithms_unchanged=True,model_only_changed_sources=delta,geometry_artifacts_verified=True,
+        geometry_artifacts_verified_count=1691,geometry_artifacts_sha256={str(i):'a'*64 for i in range(1691)})
+    frozen={'runtime_sha256':deepcopy(current['source_code_sha256']),'build_input_sha256':deepcopy(current['source_code_sha256'])}
+    return current,frozen,parent,old
+
+
+def test_model_replay_gate_requires_frozen_identical_geometry_parent():
+    module=release_module();receipt,frozen,parent,old=model_evidence(module)
+    result=module.validate_corpus_receipt(receipt,frozen,geometry_parent=parent,geometry_frozen=old)
+    assert result['image_execution'] is False
+    assert result['geometry_source_verified'] is True
+
+
+@pytest.mark.parametrize('field,value',[
+    ('geometry_algorithms_unchanged',False),('geometry_parent_receipt_sha256','d'*64),
+    ('geometry_source_code_digest','d'*64),('geometry_source_freeze_identity_sha256','d'*64),
+    ('geometry_artifacts_verified',False),('geometry_artifacts_verified_count',1690),
+    ('geometry_artifacts_sha256',{}),('model_only_changed_sources',[])])
+def test_model_replay_gate_rejects_missing_or_changed_geometry_evidence(field,value):
+    module=release_module();receipt,frozen,parent,old=model_evidence(module);receipt[field]=value
+    with pytest.raises(RuntimeError):module.validate_corpus_receipt(receipt,frozen,geometry_parent=parent,geometry_frozen=old)
+
+
+def test_model_replay_gate_cannot_reuse_geometry_after_a_section_algorithm_change():
+    module=release_module();receipt,frozen,parent,old=model_evidence(module)
+    key='external/print-strength-engine/print_strength_engine/automatic_sections.py'
+    for mapping in (receipt['source_code_sha256'],receipt['source_code_sha256_end'],frozen['runtime_sha256'],frozen['build_input_sha256']):mapping[key]='c'*64
+    receipt['source_code_digest']=module.sha256(module.canonical(receipt['source_code_sha256']))
+    receipt['model_only_changed_sources'].append(key)
+    with pytest.raises(RuntimeError):module.validate_corpus_receipt(receipt,frozen,geometry_parent=parent,geometry_frozen=old)
