+from unittest.mock import patch
+
+from app import automatic_capacity, local_geometry
+
+
+def common_product_candidate():
+    from print_strength_engine.automatic_sections import StreamingSections
+    row=reference();row['material_area_proxy_mm2']=4
+    writer=StreamingSections([row])
+    writer.segment([1,2,.2],[5,2,.2],1,.2,0)
+    writer.segment([5,2,.2],[9,2,.2],1,.2,3)
+    row['deposited_section']=writer.finish()[row['region_id']]
+    return row
+
+
+def common_product_analysis(second='Bambu PLA Basic @BBL H2C',material='PLA'):
+    return {'detected_materials':list(dict.fromkeys(['PLA',material])), 'material_usage':[
+        {'tool_id':0,'material':'PLA','sku_profile':'Bambu PLA Basic @BBL H2C','grams':'3','used_for_object':True},
+        {'tool_id':3,'material':material,'sku_profile':second,'grams':'3','used_for_object':True}]}
+
+
+def test_identical_exact_product_multiple_tools_calculate_without_relabeling_geometry():
+    from app.strength_points import attach_capacity
+    original=common_product_candidate();before=copy.deepcopy(original)
+    row=attach_capacity([original],None,common_product_analysis())[0]
+    value=row['estimated_capacity'] or {}
+    assert value.get('calculation_status')=='AUTOMATIC_REFERENCE_LOAD_ESTIMATE'
+    assert value['axial_capacity_n']>0 and value['bending_force_n']>0
+    assert row['deposited_section']['tools']==[0,3]
+    assert value['homogeneous_material_assumption']['tool_ids']==[0,3]
+    assert row['capacity_material_reference']['common_product_tool_reference']['verified'] is False
+    assert original==before
+
+
+@pytest.mark.parametrize('profile,material',[
+    ('Generic PLA','PLA'),('Bambu PLA Matte','PLA'),('eSUN PLA-Basic','PLA'),
+    ('Bambu ABS','ABS'),('','PLA')])
+def test_different_or_unresolved_products_never_inherit_common_product_permission(profile,material):
+    from app.strength_points import attach_capacity
+    row=attach_capacity([common_product_candidate()],None,common_product_analysis(profile,material))[0]
+    assert (row.get('estimated_capacity') or {}).get('axial_capacity_n') is None
+    assert not (row.get('capacity_material_reference') or {}).get('common_product_tool_reference')
+
+
+def test_missing_actual_tool_is_not_replaced_by_the_first_slot():
+    from app.strength_points import attach_capacity
+    analysis=common_product_analysis();analysis['material_usage'][1]['tool_id']=4
+    row=attach_capacity([common_product_candidate()],None,analysis)[0]
+    assert row.get('estimated_capacity') is None
+    assert row['capacity_material_gap']=='SECTION_TOOL_MATERIAL_UNRESOLVED'
+
+
+@pytest.mark.parametrize('field,value',[
