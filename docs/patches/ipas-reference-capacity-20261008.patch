+    from app.strength_reference import reference_for_subset
+    analysis=common_product_analysis();combined=reference_for_subset(analysis,[0,3])
+    original=reference_for_subset(analysis,[0]);changed=reference_for_subset(analysis,[3])
+    changed[field]=value
+    assert _common_product_reference(analysis,[0,3],combined,{(0,):original,(3,):changed}) is None
+
