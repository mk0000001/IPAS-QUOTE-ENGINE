+def _absolute_dimension(config,keys,minimum):
+    for key in keys:
+        if key not in config:continue
+        raw=config[key]
+        if isinstance(raw,bool) or not isinstance(raw,(str,int,float)):return None
+        try:value=float(raw)
+        except (TypeError,ValueError,OverflowError):return None
+        return value if math.isfinite(value) and minimum<=value<=5 else None
+    return None
+
