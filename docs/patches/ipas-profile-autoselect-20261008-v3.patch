+def _manual_configuration(analysis, fresh, selections):
+    """Change only configuration slots proven to belong to selected tools."""
+    configuration = deepcopy(analysis.get('configuration') or {})
+    configured = configuration.get('filament_settings_id')
+    profiles = list(_list(configured)) if configured is not None else []
+    types = list(_types(configuration.get('filament_type'))) if configuration.get('filament_type') else []
+    source_rows = fresh['material_usage']
+    bindings = {}
+    if profiles:
+        for index, row in enumerate(source_rows):
+            identity = row['profile_identity']
+            binding = _configuration_slot(analysis, row, profiles, types, row.get('material'))
+            if binding is None or identity['match_status'] != 'matched':
+                continue
+            slot, _ = binding
+            # A raw name alone does not prove that a configuration slot is its
+            # counterpart. Require the fresh parser's identities to agree.
+            configured_identity = parse(profiles[slot], row.get('material'))
+            if (configured_identity['match_status'] == 'matched' and
+                    configured_identity['canonical_profile'] == identity['canonical_profile']):
+                bindings[index] = slot
+    elif (source_rows and all(row['profile_identity'].get('profile_source') == 'MATERIAL_FAMILY_ONLY'
+                             for row in source_rows)):
+        # A manual raw name ends the global metadata-absent fallback. Keep the
+        # other rows' already established Generic identities in proven slots.
+        tools = [row.get('tool_id') for row in source_rows]
+        if (all(isinstance(tool, int) and not isinstance(tool, bool) and 0 <= tool <= 4096 for tool in tools)
+                and len(set(tools)) == len(tools)):
+            for index, row in enumerate(source_rows):
+                binding = (_configuration_slot(analysis, row, [None] * len(types), types, row.get('material'))
+                           if types else None)
+                bindings[index] = binding[0] if binding is not None else row['tool_id']
+            if len(set(bindings.values())) == len(bindings):
+                size = max(bindings.values()) + 1
+                profiles = [None] * max(size, len(types))
+                types.extend([None] * (len(profiles) - len(types)))
+                for index, slot in bindings.items():
+                    profiles[slot] = source_rows[index]['profile_identity']['canonical_profile']
+                    types[slot] = source_rows[index]['material']
+            else:
+                bindings = {}
+    for row in selections:
+        if row['selection_basis'] == 'GCODE_PROFILE_CATALOG' or row['usage_index'] not in bindings:
+            continue
+        slot = bindings[row['usage_index']]
+        profiles[slot] = row['selected_profile']
+        if slot >= len(types):
+            types.extend([None] * (slot + 1 - len(types)))
+        types[slot] = row['material']
+    if bindings:
+        configuration['filament_settings_id'] = profiles
+        if types:
+            configuration['filament_type'] = types
+    return configuration
+
