diff --git a/tests/test_automatic_compact_cache_policy.py b/tests/test_automatic_compact_cache_policy.py
new file mode 100644
--- /dev/null
+++ b/tests/test_automatic_compact_cache_policy.py
@@ -0,0 +1,181 @@
+"""Synthetic selective retry; complete legacy numeric caches stay current."""
+from copy import deepcopy
+import json
+from unittest.mock import patch
+import pytest
+
+from app import automatic_capacity as automatic
+from app.local_geometry import LOCAL_FILE,VERSION
+from print_strength_engine import automatic_sections as sections
+
+POLICY={'id':'EXACT_UNION_COMPACT_V1','max_packed_bytes':128*1024**2,'per_cut_max_union_vertices':1000000}
+
+
+def local():
+    return {'version':VERSION,'status':'THIN_REGIONS_FOUND','candidates':[{
+        'region_id':'synthetic-plane','kind':'LOCAL_THIN_SECTION','section_normal_axis':'X',
+        'section_station_mm':50,'axial_section_station_mm':50,'bending_section_station_mm':50,
+        'section_window_bounds_mm':[[40,60],[-1,11],[-1,3]],
+        'bounds_mm':[[45,55],[0,10],[0,2]],'position_mm':[50,5,1]}]}
+
+
+def beam_source():
+    lines=['G90','M83',';WIDTH:1',';HEIGHT:1']
+    for z in (1,2):
+        lines+=[';LAYER_CHANGE',f'G0 Z{z}']
+        for y in range(10):lines += [f'G0 X0 Y{y+.5}','G1 X100 E1']
+    return ('\n'.join(lines)+'\n').encode()
+
+
+def prepare(tmp_path,*,raw_cap=None,invalid_source=False):
+    directory=tmp_path/'cache';directory.mkdir()
+    document=local();(directory/LOCAL_FILE).write_text(json.dumps(document),encoding='utf-8')
+    source=tmp_path/'synthetic.gcode'
+    invalid=b'G90\nM83\n;WIDTH:1\n;HEIGHT:1\nG0 Z0\nG1 X1 Z1 E1\n' if invalid_source else b''
+    source.write_bytes(invalid+beam_source())
+    if raw_cap is None:value=automatic.compute(source,directory,source_sha256='synthetic-source')
+    else:
+        with patch.object(sections,'MAX_SECTION_PIECES',raw_cap):
+            value=automatic.compute(source,directory,source_sha256='synthetic-source')
+    return directory,document,value
+
+
+def write(directory,value):
+    (directory/automatic.FILE).write_text(json.dumps(value),encoding='utf-8')
+
+
+def old_budget_fixture(value):
+    """Valid empty withheld descriptor from a complete scan, not a numeric prefix."""
+    value=deepcopy(value);value.pop('section_resource_policy',None)
+    value['status']='WITHHELD'
+    for section in value['sections'].values():
+        for key in ('axial','bending'):section[key]=None
+        for key in ('area_mm2','min_principal_section_modulus_mm3','minimum_all_direction_section_modulus_mm3',
+                    'weakest_local_bending_stress_gradient_xyz','critical_bending_moment_direction_xyz'):
+            section[key]=None
+        section.update(status='WITHHELD',complete=False,tools=[],assessment_gaps=['LOCAL_SECTION_GEOMETRY_BUDGET_EXCEEDED'])
+        section.pop('resource_compaction',None)
+    return value
+
+
+def test_complete_legacy_cache_without_policy_remains_current_and_byte_identical(tmp_path):
+    directory,document,value=prepare(tmp_path)
+    value.pop('section_resource_policy',None);write(directory,value)
+    before=(directory/automatic.FILE).read_bytes()
+    assert automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+    assert (directory/automatic.FILE).read_bytes()==before
+
+
+def test_old_budget_only_cache_without_policy_is_selectively_stale(tmp_path):
+    directory,document,value=prepare(tmp_path,raw_cap=1)
+    value=old_budget_fixture(value);write(directory,value)
+    assert not automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def test_available_policy_alone_does_not_prevent_retry_of_old_budget_failure(tmp_path):
+    directory,document,value=prepare(tmp_path,raw_cap=1)
+    value=old_budget_fixture(value);value['section_resource_policy']=POLICY;write(directory,value)
+    assert not automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def test_matching_failed_compact_attempt_is_current_without_retry_loop(tmp_path):
+    directory,document,value=prepare(tmp_path,raw_cap=1)
+    value=old_budget_fixture(value);value['section_resource_policy']=POLICY
+    for section in value['sections'].values():
+        section['resource_compaction']={'policy_id':POLICY['id'],'attempted':True,'applied':False,
+                                        'status':'RESOURCE_BUDGET_EXCEEDED',
+                                        'max_packed_bytes':POLICY['max_packed_bytes'],
+                                        'peak_shared_packed_bytes':0,'peak_shared_coordinates':0}
+    write(directory,value)
+    assert automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def test_unknown_failed_compact_policy_cannot_make_old_budget_cache_current(tmp_path):
+    directory,document,value=prepare(tmp_path,raw_cap=1)
+    value=old_budget_fixture(value);value['section_resource_policy']=POLICY
+    for section in value['sections'].values():
+        section['resource_compaction']={'policy_id':'unknown-policy','attempted':True,'applied':False,
+                                        'status':'RESOURCE_BUDGET_EXCEEDED'}
+    write(directory,value)
