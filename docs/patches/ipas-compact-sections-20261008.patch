+"""A valid declared numeric cache survives optional volume-only budget gaps."""
+from app import automatic_capacity as automatic
+from test_automatic_compact_cache_policy import prepare,write,POLICY,old_budget_fixture
+import pytest
+
+
+def fixture(tmp_path):
+    directory,document,value=prepare(tmp_path)
+    assert value['status']=='COMPLETE'
+    value.pop('section_resource_policy',None)
+    for process in value['local_process'].values():
+        section=process['volume_section']
+        assert section['status']=='WITHHELD'
+        section['assessment_gaps']=['LOCAL_SECTION_GEOMETRY_BUDGET_EXCEEDED']
+        section.pop('resource_compaction',None)
+    return directory,document,value
+
+
+def test_declared_complete_legacy_numeric_cache_survives_optional_volume_budget_only(tmp_path):
+    directory,document,value=fixture(tmp_path);write(directory,value)
+    before=(directory/automatic.FILE).read_bytes()
+    assert automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+    assert (directory/automatic.FILE).read_bytes()==before
+
+
+def test_actual_unknown_volume_compaction_marker_is_still_rejected(tmp_path):
+    directory,document,value=fixture(tmp_path);value['section_resource_policy']=POLICY
+    for process in value['local_process'].values():
+        process['volume_section']['resource_compaction']={'policy_id':'unknown-policy','attempted':True,
+                                                        'applied':False,'status':'RESOURCE_BUDGET_EXCEEDED'}
+    write(directory,value)
+    assert not automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def marker(*,applied):
+    return {'policy_id':POLICY['id'],'attempted':True,'applied':applied,
+            'status':'APPLIED' if applied else 'RESOURCE_BUDGET_EXCEEDED',
+            'max_packed_bytes':POLICY['max_packed_bytes'],
+            'peak_shared_packed_bytes':POLICY['max_packed_bytes']+1,'peak_shared_coordinates':100}
+
+
+@pytest.mark.parametrize('field,bad',[
+    ('max_packed_bytes',None),('max_packed_bytes',float(POLICY['max_packed_bytes'])),
+    ('max_packed_bytes',2*POLICY['max_packed_bytes']),
+    ('peak_shared_packed_bytes',True),('peak_shared_packed_bytes',-1),('peak_shared_packed_bytes',1.5),
+    ('peak_shared_coordinates',False),('peak_shared_coordinates',-1),('peak_shared_coordinates',1.5)])
+def test_compaction_resource_marker_rejects_invalid_limits_and_peak_types(tmp_path,field,bad):
+    directory,document,value=fixture(tmp_path);value['section_resource_policy']=POLICY
+    for section in value['sections'].values():section['resource_compaction']={**marker(applied=True),field:bad}
+    write(directory,value)
+    assert not automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def test_applied_marker_can_share_peak_from_another_cut_rejected_above_cap(tmp_path):
+    directory,document,value=fixture(tmp_path);value['section_resource_policy']=POLICY
+    for section in value['sections'].values():section['resource_compaction']=marker(applied=True)
+    write(directory,value)
+    assert automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
+
+
+def test_failed_compact_marker_with_valid_resource_fields_remains_terminal(tmp_path):
+    directory,document,value=prepare(tmp_path);value=old_budget_fixture(value)
+    value['section_resource_policy']=POLICY
+    for section in value['sections'].values():section['resource_compaction']=marker(applied=False)
+    write(directory,value)
+    assert automatic.current(directory,document,source_sha256='synthetic-source',archive_member='')
