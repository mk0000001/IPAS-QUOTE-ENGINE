+"""Positive conditional loads must not disappear through display rounding."""
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import unittest
+
+from app.strength_points import force_label
+from app import strength_points
+from app.report_capacity_layout import summary_columns, technical_rows
+
+
+ROOT = Path(__file__).resolve().parents[1]
+TINY_ACTUAL_COMPONENT_N = 2.4697387029245935e-6
+POSITIVE_SMALL_FORCES = (5e-324, 1e-300, 1e-20, 1e-8, 1e-6, TINY_ACTUAL_COMPONENT_N,
+                         .00009999, .0001, .001, .004903325, .00980665, .00999)
+
+
+class SmallForceDisplayTests(unittest.TestCase):
+    def test_positive_tiny_section_dimensions_do_not_display_as_zero(self):
+        for value, expected in [(0.0017720391508049347, '0.00177'), (1.3207e-6, '1.32e-6'),
+                                (0, '0.00'), (11.03, '11.03'), (1.62, '1.62')]:
+            with self.subTest(value=value):
+                self.assertEqual(strength_points.section_measure_label(value), expected)
+
+    def test_tiny_selected_section_is_visible_in_report_summary_and_detail(self):
+        capacity = {'calculation_status': 'AUTOMATIC_REFERENCE_LOAD_ESTIMATE',
+            'bending_force_n': TINY_ACTUAL_COMPONENT_N, 'axial_capacity_n': .08284283,
+            'section_modulus_mm3': 1.3207e-6,
+            'bending_lever_mm': 25, 'effective_load_bearing_area_mm2': .0017720391508049347,
+            'geometry_scenarios': {'selected_geometry': 'DECLARED_ROADS',
+                'selected_axial_geometry': 'DECLARED_ROADS',
+                'declared': {'area_mm2': .0017720391508049347}}}
+        candidate = {'kind': 'LOCAL_THIN_SECTION', 'position_mm': [0, 0, 1], 'rank': 1,
+            'layer_number': 17, 'estimated_capacity': capacity,
