+def _current_section_resource_policy(value):
+    """Retry old budget-only caches only when no valid declared section remains."""
+    declared=list(value['sections'].values())
+    has_declared_complete=any(section['status']=='COMPLETE' for section in declared)
+    volumes=[process['volume_section'] for process in value['local_process'].values()]
+    budget_gaps={'LOCAL_SECTION_GEOMETRY_BUDGET_EXCEEDED',RESOURCE_GAP}
+    inspected=[(True,section) for section in declared]+[(False,section) for section in volumes]
+    for retry_eligible,section in inspected:
+        gaps=set(section.get('assessment_gaps') or [])
+        budget_only=(retry_eligible and not has_declared_complete and section['status']=='WITHHELD' and bool(gaps & budget_gaps) and gaps<=budget_gaps
+                     and value.get('source_scan_complete') is True and value.get('source_geometry_complete') is True)
+        marker=section.get('resource_compaction')
+        if marker is None:
+            if budget_only:return False
+            continue
+        if value.get('section_resource_policy')!=resource_policy():return False
+        if not isinstance(marker,dict) or marker.get('policy_id')!=POLICY_ID or marker.get('attempted') is not True:return False
+        limit=marker.get('max_packed_bytes')
+        if type(limit) is not int or limit!=resource_policy()['max_packed_bytes']:return False
+        for key in ('peak_shared_packed_bytes','peak_shared_coordinates'):
+            peak=marker.get(key)
+            if type(peak) is not int or peak<0:return False
+        if section['status']=='COMPLETE':
+            if marker.get('applied') is not True or marker.get('status')!='APPLIED':return False
+        else:
+            if marker.get('applied') is not False:return False
+            expected='RESOURCE_BUDGET_EXCEEDED' if gaps & budget_gaps else 'WITHHELD'
+            if marker.get('status')!=expected:return False
+    return True
 
 
